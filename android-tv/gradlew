#!/bin/sh
# Minimal Gradle wrapper launcher, written by hand.
# The wrapper jar is NOT kept in the repo (CI uses a pinned Gradle instead).
# To get it locally, with Gradle 8.11.1 installed, run once:  gradle wrapper --gradle-version 8.11.1

APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit 1
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "gradle-wrapper.jar is missing. Run: gradle wrapper --gradle-version 8.11.1" >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi

exec "$JAVACMD" -Xmx64m -Xms64m $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=gradlew" \
    -classpath "$WRAPPER_JAR" \
    org.gradle.wrapper.GradleWrapperMain "$@"
