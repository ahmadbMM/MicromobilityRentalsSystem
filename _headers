# The Content-Security-Policy line is written by scripts/build-html.mjs (npm run build:html): it
# names the inline scripts by their hashes and allows no other inline script or handler.
# Change the policy in that script, not here.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=(self)
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-FPttNqKT4vxF8YOCyDOK/1QRSh5DPY3VDtnOdtlIjAM=' 'sha256-vnQ70ktCoJqDhFZpf0LxfFQmZhSX6XIw+jH/p/hgsxo=' 'sha256-BEhapJLTZY3PDRqGgNxQ5otG+pP9GJC4OhSlHdr/g68=' 'sha256-1E+Wm6tjxYgugaeC52pKURcV0bGSKSLNGIMafSNnAAk=' 'sha256-Be7JnV8SM+ZZ1uOIAc0EVyI9URnE0WACPh+UIwF442M=' 'sha256-G+Jl6lGMPPc9+wKhNDAAwf8eUSXJLYIVU98RR4ubra8=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://micromobility.sa https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com https://api.open-meteo.com https://archive-api.open-meteo.com; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp
  Reporting-Endpoints: csp="/api/csp-report"

# Version-pinned assets: filenames (vendor/, fonts/) or a content-hash query
# (styles.css?v=<hash>, rewritten by scripts/build-html.mjs) change whenever the bytes do,
# so they can be cached hard. HTML stays uncached so a deploy is picked up immediately.
# splash/ has no rule of its own: its names are screen sizes, not versions, and Cloudflare
# JOINS the values when two rules match one path, so a /splash/* rule beside /*.png served
# "max-age=31536000, immutable, public, max-age=604800". The splash PNGs take /*.png.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/staff.js
  Cache-Control: public, max-age=31536000, immutable
/lang/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/index.html
  Cache-Control: public, max-age=0, must-revalidate
