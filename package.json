{
  "name": "micromobility-queue",
  "private": true,
  "version": "1.0.0",
  "description": "MicroMobility Rentals - customer booking + staff rental and inventory system",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "serve": "node scripts/serve.mjs 4173",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit && npm run check:i18n",
    "check:i18n": "node scripts/check-i18n.mjs",
    "format": "prettier --write tests vite.config.ts eslint.config.mjs",
    "build:html": "node scripts/build-html.mjs",
    "build:dist": "node scripts/build-html.mjs && node scripts/assemble-dist.mjs",
    "build:wallet": "node -e \"console.error('build:wallet is retired. functions/api/wallet-pass.js is maintained DIRECTLY and is ahead of scripts/wallet/wallet-pass.src.js; rebuilding would revert the collection times, ride colours, pass expiry and the directions link. Edit functions/api/wallet-pass.js.');process.exit(1)\"",
    "deploy:now": "bash scripts/deploy-now.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "fflate": "^0.8.2",
    "html-minifier-terser": "^7.2.0",
    "node-forge": "^1.3.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
